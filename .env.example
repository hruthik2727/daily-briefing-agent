# Generate a long random Django secret. Never commit your real .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
APP_BASE_URL=http://127.0.0.1:8000

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/gmail/callback/

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Optional: if absent, summaries use Gmail snippets and local rules.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
